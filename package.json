{
  "name": "cybersecurity-learning-hub-api",
  "version": "1.0.0",
  "description": "Mini-projet universitaire GraphQL pour un hub d'apprentissage en cybersecurity.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "lint": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@graphql-tools/schema": "^10.0.19",
    "@prisma/client": "^5.16.2",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.23.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.16.0",
    "graphql-tag": "^2.12.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "prettier": "^3.3.3",
    "prisma": "^5.16.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
